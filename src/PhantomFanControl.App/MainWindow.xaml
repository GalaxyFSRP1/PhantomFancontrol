<Window x:Class="PhantomFanControl.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Phantom Fan Control" Width="1150" Height="750" Background="{StaticResource Surface}" Foreground="White">
 <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel><TextBlock Text="PHANTOM" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="FAN CONTROL" FontSize="14" Margin="2,0,0,28"/><Button Content="Dashboard" Click="Dashboard_Click"/><Button Content="Hardware &amp; sensors" Click="Hardware_Click"/><Button Content="Fan curves" Click="Curves_Click"/><Button Content="Calibration" Click="Calibration_Click"/><Button Content="Diagnostics" Click="Diagnostics_Click"/><Button Content="Settings" Click="Settings_Click"/><Separator Margin="4,20"/><TextBlock Text="Safety-first hardware control" Foreground="#B7BFCC" TextWrapping="Wrap"/></StackPanel>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="Active profile:" VerticalAlignment="Center" Margin="8"/><ComboBox x:Name="Profiles" Width="145" SelectionChanged="Profile_Changed"/></StackPanel></DockPanel><ContentControl x:Name="Page" Grid.Row="1" Margin="0,22,0,0"/></Grid>
 </Grid>
</Window>
